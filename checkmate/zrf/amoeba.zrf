(define check-platform
  mark down
  (verify (piece? Platform))
  back
)

(define pawn-shift (
  $1 (verify empty?)
  (check-platform)
  add
))

(define pawn-step (
  $1 (verify enemy?)
  (check-platform)
  add
))

(define step (
  $1 (verify not-friend?)
  (check-platform)
  add
))

(define leap (
  $1 $2 (verify not-friend?)
  (check-platform)
  add
))

(define slide (
  $1 
  (while empty? (check-platform) add $1)
  (verify not-friend?)
  (check-platform)
  add
))

(game
  (title "Amoeba")
  (history "Copyrigt (c) 1997 Jim Aikin.")

  (players White Black)
  (turn-order White Black)

  (board
     (image "images/blank.bmp")
     (grid
         (start-rectangle 2 2 70 70)
         (dimensions
           ("A/B/C/D/E/F/G" (68 0)) ; files
           ("7/6/5/4/3/2/1" (0 68)) ; ranks
         )
         (directions 
           (n 0 -1) (s 0 1) (e 1 0) (w -1 0)
         )
     )
     (grid
         (start-rectangle 2 2 70 70)
         (dimensions
           ("a/b/c/d/e/f/g" (68 0)) ; files
           ("7/6/5/4/3/2/1" (0 68)) ; ranks
         )
         (directions 
              (n 0 -1) (s 0 1) (e 1 0) (w -1 0)
              (nw -1 -1) (sw -1 1) (ne 1 -1) (se 1 1)
         )
     )
     (links up
         (A1 a1) (B1 b1) (C1 c1) (D1 d1) (E1 e1) (F1 f1) (G1 g1)
         (A2 a2) (B2 b2) (C2 c2) (D2 d2) (E2 e2) (F2 f2) (G2 g2)
         (A3 a3) (B3 b3) (C3 c3) (D3 d3) (E3 e3) (F3 f3) (G3 g3)
         (A4 a4) (B4 b4) (C4 c4) (D4 d4) (E4 e4) (F4 f4) (G4 g4)
         (A5 a5) (B5 b5) (C5 c5) (D5 d5) (E5 e5) (F5 f5) (G5 g5)
         (A6 a6) (B6 b6) (C6 c6) (D6 d6) (E6 e6) (F6 f6) (G6 g6)
         (A7 a7) (B7 b7) (C7 c7) (D7 d7) (E7 e7) (F7 f7) (G7 g7)
     )
     (links down
         (a1 A1) (b1 B1) (c1 C1) (d1 D1) (e1 E1) (f1 F1) (g1 G1)
         (a2 A2) (b2 B2) (c2 C2) (d2 D2) (e2 E2) (f2 F2) (g2 G2)
         (a3 A3) (b3 B3) (c3 C3) (d3 D3) (e3 E3) (f3 F3) (g3 G3)
         (a4 A4) (b4 B4) (c4 C4) (d4 D4) (e4 E4) (f4 F4) (g4 G4)
         (a5 A5) (b5 B5) (c5 C5) (d5 D5) (e5 E5) (f5 F5) (g5 G5)
         (a6 A6) (b6 B6) (c6 C6) (d6 D6) (e6 E6) (f6 F6) (g6 G6)
         (a7 A7) (b7 B7) (c7 C7) (d7 D7) (e7 E7) (f7 F7) (g7 G7)
     )
     (symmetry Black (n s) (s n) (nw sw) (sw nw) (ne se) (se ne) (w w) (e e) (up up) (down down))
  )

  (piece
     (name Hole)
     (image White "images/hole.bmp"
            Black "images/hole.bmp")
  )
  (piece
     (name Platform)
     (image White "images/white.bmp"
            Black "images/black.bmp")
  )
  (piece
     (name Pawn)
     (image White "images/wpawn.bmp"
            Black "images/bpawn.bmp")
     (moves
         (pawn-shift n)
         (pawn-step nw) (pawn-step ne)
     )
  )
  (piece
     (name Rook)
     (image White "images/wrook.bmp"
            Black "images/brook.bmp")
     (moves
         (slide n) (slide s) (slide w) (slide e)
     )
  )
  (piece
     (name Knight)
     (image White "images/wknight.bmp"
            Black "images/bknight.bmp")
     (moves
         (leap n nw) (leap n ne) (leap s sw) (leap s se)
         (leap w nw) (leap w sw) (leap e ne) (leap e se)
     )
  )
  (piece
     (name King)
     (image White "images/wking.bmp"
            Black "images/bking.bmp")
     (moves
         (step n) (step s) (step w) (step e)
         (step nw) (step sw) (step ne) (step se)
     )
  )

  (board-setup
    (White 
         (Platform A3 A5 B2 B4 B6 C1 C3 C5 C7 D2 D6 E1 E3 E5 E7 F2 F4 F6 G3 G5)
         (Hole A1 A2 A6 A7 C4 D4 E4 G1 G2 G6 G7)
         (Pawn b2 c2 d2 e2 f2)
         (Rook b1 f1)
         (Knight c1 e1)
         (King d1)
    )
    (Black 
         (Platform A4 B1 B3 B5 B7 C2 C6 D1 D3 D5 D7 E2 E6 F1 F3 F5 F7 G4)
         (Pawn b6 c6 d6 e6 f6)
         (Rook b7 f7)
         (Knight c7 e7)
         (King d7)
    )
  )
)
